// PoliVid database schema.
// User, Account, Session and VerificationToken are the Auth.js (NextAuth v5)
// Prisma adapter models; keep their field names as they are.
// Docs: docs/SETUP.md (database) and docs/ARCHITECTURE.md (data model).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  stripeCustomerId   String?   @unique
  plan               String    @default("free")
  subscriptionId     String?
  subscriptionStatus String?
  billingInterval    String?
  currentPeriodEnd   DateTime?
  planCredits        Int       @default(0)
  bonusCredits       Int       @default(100)
  creditsRefillAt    DateTime?
  accounts           Account[]
  sessions           Session[]
  videos             Video[]
  videoJobs          VideoJob[]
  editProjects       EditProject[]
  productions        Production[]
  creditLedger       CreditLedger[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// One credit grant, hold, refund, or refill. Stripe event IDs are idempotency keys.
model CreditLedger {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta          Int
  bucket         String // plan | bonus
  reason         String // trial | refill | topup | video_hold | video_refund | production_hold | production_refund
  refType        String?
  refId          String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

/// OAuth accounts linked to a user (Google).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

/// Database sessions. The browser only holds the opaque sessionToken cookie.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One-time tokens for email (Resend magic link) sign-in.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// A generated video. facts/quotes/plan are JSON matching lib/video/schema.ts.
model Video {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt            String
  format            String // "9:16" | "16:9" | "1:1"
  length            Int // target seconds: 30 | 60 | 90
  status            String // "ready" | "failed"
  title             String
  facts             Json // Fact[]
  quotes            Json // SourcedQuote[]
  plan              Json? // ScenePlan, null when generation failed
  searchSources     Json // SearchSource[]: URLs the web search returned
  unverifiedFactIds String[]
  model             String // OpenRouter model slug, or "demo"
  demo              Boolean  @default(false)
  error             String?
  parentVideoId     String?
  parentVideo       Video?   @relation("VideoLineage", fields: [parentVideoId], references: [id], onDelete: SetNull)
  childVideos       Video[]  @relation("VideoLineage")
  editProjectId     String?
  editProject       EditProject? @relation("EditExports", fields: [editProjectId], references: [id], onDelete: SetNull)
  sourceProjects    EditProject[] @relation("EditSource")
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

/// A timeline the user is editing. Copy-on-edit: the source video is never written.
model EditProject {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVideoId String?
  sourceVideo   Video?   @relation("EditSource", fields: [sourceVideoId], references: [id], onDelete: SetNull)
  title         String
  format        String
  timeline      Json
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exports       Video[]  @relation("EditExports")
  productions   Production[] @relation("ProductionEdit")

  @@index([userId, updatedAt])
  @@map("edit_projects")
}

/// One user-facing video request. The row is the source of truth for progress.
model VideoJob {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String // queued | running | succeeded | failed | canceled
  currentStep  String? // script | images | videos | render | finalize
  progressPct  Int       @default(0)
  input        Json
  artifacts    Json      @default("{}")
  outputUrl    String?
  error        String?
  errorDetail  Json?
  attempt      Int       @default(0)
  costUsd      Decimal   @default(0) @db.Decimal(10, 4)
  creditsHeld  Int       @default(0)
  triggerRunId String?
  heartbeatAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  providerJobs ProviderJob[]

  @@index([userId, status])
  @@index([status, heartbeatAt])
  @@map("video_jobs")
}

/// One provider video job (OpenRouter or Google). Providers accept no custom metadata, so this row maps the job back to a scene.
model ProviderJob {
  providerJobId String   @id
  provider      String   @default("openrouter")
  jobId         String
  job           VideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sceneIdx      Int
  waitToken     String?
  status        String // pending | in_progress | completed | failed | cancelled | expired
  costUsd       Decimal? @db.Decimal(10, 4)
  contentUrl    String?
  storedUrl     String?
  lastPolledAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([jobId, sceneIdx])
  @@map("provider_jobs")
}

/// Dedupes OpenRouter webhook deliveries. The key is X-OpenRouter-Idempotency-Key.
model WebhookEvent {
  idempotencyKey String   @id
  receivedAt     DateTime @default(now())
  payload        Json

  @@map("webhook_events")
}

/// A staged AI video production. The database is authoritative for every stage.
model Production {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  status             String // drafting | awaiting_answers | preview | generating | reviewing | assembling | ready | failed | canceled
  stage              String // intake | develop | structure | preview | references | speech | shots | review | music | assemble | done
  mode               String // review | auto
  creativeDelegation Boolean  @default(false)
  plannerProvider    String // claude | openai
  budgetUsd          Decimal  @default(10) @db.Decimal(10, 4)
  spentUsd           Decimal  @default(0) @db.Decimal(10, 4)
  creditsHeld        Int      @default(0)
  format             String
  targetDurationSec  Int
  editProjectId      String?
  editProject        EditProject? @relation("ProductionEdit", fields: [editProjectId], references: [id], onDelete: SetNull)
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  entities           ProductionEntity[]
  assets             ProductionAsset[]
  steps              ProductionStep[]
  jobs               GenerationJob[]
  dependencies       ProductionDependency[]
  usage              UsageLedger[]

  @@index([userId, updatedAt])
  @@map("productions")
}

model ProductionEntity {
  id                String   @id @default(uuid())
  productionId      String
  production        Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  kind              String
  stableKey         String
  currentVersionId  String?
  acceptedVersionId String?
  createdAt         DateTime @default(now())
  versions          EntityVersion[]

  @@unique([productionId, kind, stableKey])
  @@index([productionId, kind])
  @@map("production_entities")
}

model EntityVersion {
  id              String   @id @default(uuid())
  entityId        String
  entity          ProductionEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  version         Int
  data            Json
  origin          String // user | planner | observed | system
  createdByStepId String?
  status          String // draft | accepted | superseded | stale
  createdAt       DateTime @default(now())

  @@unique([entityId, version])
  @@index([entityId, status])
  @@map("entity_versions")
}

model ProductionAsset {
  id              String   @id @default(uuid())
  productionId    String
  production      Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  storageKey      String
  kind            String // image | video | audio | caption
  mime            String
  sha256          String
  probe           Json     @default("{}")
  producedByJobId String?
  inputVersionIds String[]
  status          String // candidate | accepted | rejected | alternate
  createdAt       DateTime @default(now())

  @@index([productionId, kind])
  @@map("production_assets")
}

model ProductionStep {
  id              String    @id @default(uuid())
  productionId    String
  production      Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  kind            String
  status          String // pending | ready | leased | waiting_provider | succeeded | failed | canceled | blocked
  dependsOn       String[]
  leaseUntil      DateTime?
  workerId        String?
  attempt         Int       @default(0)
  maxAttempts     Int       @default(2)
  idempotencyKey  String    @unique
  inputHash       String
  targetKey       String    @default("")
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  jobs            GenerationJob[]

  @@index([productionId, status])
  @@index([status, leaseUntil])
  @@map("production_steps")
}

model GenerationJob {
  id                 String    @id @default(uuid())
  productionId       String
  production         Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  stepId             String
  step               ProductionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  provider           String
  route              String
  modelId            String
  request            Json
  settings           Json      @default("{}")
  interactionContext Json?
  providerJobId      String?
  status             String // pending | submitting | in_progress | completed | failed | canceled | expired | needs_reconcile
  outputs            Json      @default("[]")
  usage              Json      @default("{}")
  estimatedUsd       Decimal   @default(0) @db.Decimal(10, 4)
  actualUsd          Decimal   @default(0) @db.Decimal(10, 4)
  submittedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([productionId, status])
  @@index([providerJobId])
  @@map("generation_jobs")
}

model ProductionDependency {
  id               String   @id @default(uuid())
  productionId     String
  production       Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  fromKind         String // entity_version | asset | timeline_span
  fromId           String
  toKind           String
  toId             String
  createdAt        DateTime @default(now())

  @@index([productionId, fromId])
  @@index([productionId, toId])
  @@map("production_dependencies")
}

model UsageLedger {
  id           String   @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  jobId        String?
  provider     String
  model        String
  units        Json     @default("{}")
  usd          Decimal  @default(0) @db.Decimal(10, 4)
  createdAt    DateTime @default(now())

  @@index([productionId, createdAt])
  @@map("usage_ledger")
}
