{
  "name": "polivid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "stripe:listen": "stripe listen --forward-to http://localhost:3100/api/stripe/webhook",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "try": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/try-pipeline.ts",
    "test": "tsx --test --test-reporter=spec 'lib/**/*.test.ts'",
    "verify:capabilities": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-capabilities.ts",
    "media:upload": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/upload-local-media.ts",
    "eval:planners": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/eval-planners.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@base-ui/react": "^1.9.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@remotion/bundler": "^4.0.535",
    "@remotion/media-utils": "^4.0.535",
    "@remotion/player": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "ai": "^7.0.140",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.535",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
