# Copy to .env.local and fill in. Setup guide: docs/SETUP.md

# Postgres on AWS RDS. Format and setup: docs/SETUP.md step 1
# postgresql://politivid_app:<password>@<endpoint>:5432/politivid?sslmode=require&connection_limit=5&pool_timeout=20
DATABASE_URL=

# Auth.js secret. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Google OAuth client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend magic-link email: API key and a sender on a verified domain
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=PoliVid <login@your-verified-domain.com>

# OpenRouter. Without it the app runs in demo mode with fictional sample data.
OPENROUTER_API_KEY=
# Signs OpenRouter video webhooks. Hex or base64 secret from the OpenRouter workspace.
OPENROUTER_WEBHOOK_SECRET=
# Public origin used as the webhook callback and Stripe return URLs, e.g. https://polivid.example.com
APP_PUBLIC_URL=

# Stripe. Restricted key (rk_...) preferred. Webhook signing secret from `stripe listen` or the Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Gemini API key (paid tier) from Google AI Studio. Adds Gemini Omni 1.1 Flash to the model picker.
GEMINI_API_KEY=

# Productions tool. mock (default) uses fixture planners and media. live spends provider credits.
PRODUCTION_PROVIDERS=mock
PLANNER_PROVIDER=claude
# Optional per-task OpenRouter slugs. Defaults: Haiku/Sonnet/Opus (Claude) or Luna/Sol/Astra (OpenAI).
# PLANNER_MODEL_EXTRACT=
# PLANNER_MODEL_DEVELOP=
# PLANNER_MODEL_STRUCTURE=
# PLANNER_MODEL_ESCALATE=
# PLANNER_MODEL_FRONTIER=
PRODUCTION_DEFAULT_BUDGET_USD=15
PRODUCTION_MAX_RETRIES=2
EVAL_BUDGET_USD=1
ELEVENLABS_API_KEY=sk_a6f75224ce4dc5f330adf100897a1870c70aa962836f3606
SYNC_API_KEY=
# Optional fallback if GPT Image models are not listed on OpenRouter.
OPENAI_API_KEY=

# One S3 bucket for app files. Image, audio, and video uploads go under uploads/{userId}/.
# Use the existing AWS app keys (AWS_ACCESS_KEY_APP / AWS_SECRET_KEY_APP / AWS_REGION_APP).
# Do not create a second or nested bucket for uploads.
AWS_S3_BUCKET=
